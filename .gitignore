# Build output - these are generated by 'dotnet build' and should never be committed.
bin/
obj/
publish/

# Visual Studio / Rider / VS Code local state
.vs/
*.user
.idea/

# Local log files (the app writes logs to %LocalAppData%, but just in case)
*.log

# Local settings that contain machine-specific / secret values.
# The real settings live in %ProgramData%\CCube\settings.json, not in the repo.
settings.local.json
